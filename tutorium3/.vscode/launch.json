{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "composition (macOS)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/composition",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build: composition"
    },
    {
      "name": "composition (Linux)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/composition",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "build: composition",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
